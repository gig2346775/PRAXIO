# Vercel > Project > Settings > Environment Variables

# Monnify dashboard > Settings > API Keys & Contracts
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Sandbox: https://sandbox.monnify.com  |  Live: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Naira per 1 USD of wallet balance
USD_TO_NGN=

# Your live site, no trailing slash
SITE_URL=https://your-domain.com

# Firebase console > Project settings > Service accounts > Generate new private key
# Paste the whole JSON on one line
FIREBASE_SERVICE_ACCOUNT=
